# ARA Coffee - .htaccess Configuration

# فعال‌سازی Rewrite Engine
RewriteEngine On

# ریدایرکت HTTP به HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# حذف پسوند .html از URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# صفحه اصلی
DirectoryIndex index.html

# جلوگیری از لیست شدن پوشه‌ها
Options -Indexes

# تنظیم کاراکتر پیش‌فرض
AddDefaultCharset UTF-8

# کش کردن فایل‌های استاتیک
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# فشرده‌سازی Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# محافظت از فایل‌های حساس
<FilesMatch "\.(json|log|md)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# اجازه دسترسی به API
<FilesMatch "^(read|write|upload)\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# صفحه 404 سفارشی
ErrorDocument 404 /index.html

# جلوگیری از Hotlink عکس‌ها
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?aracafe\.ir [NC]
    RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?localhost [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [NC,F,L]
</IfModule>
